# Optional. The settings page writes data/config.json and is easier for a laptop.
# Environment variables override the settings page when they are set.
# Leave secrets out of git.

PULSE_CANVAS_BASE_URL=https://bcourses.berkeley.edu
PULSE_CANVAS_TOKEN=
PULSE_IMAP_HOST=imap.gmail.com
PULSE_IMAP_PORT=993
PULSE_IMAP_USER=
PULSE_IMAP_PASSWORD=
PULSE_LLM_BASE_URL=https://api.openai.com/v1
PULSE_LLM_API_KEY=
PULSE_LLM_MODEL=gpt-4o-mini

# Required only if Pulse listens beyond localhost.
# PULSE_AUTH_TOKEN=
# PULSE_ALLOW_OPEN=1

# Sign-in codes. Verify a sending domain in Resend before a code can reach
# any @berkeley.edu address. onboarding@resend.dev can only reach the Resend account.
RESEND_SECRET=
RESEND_FROM=Galaxy <onboarding@resend.dev>

# Web analytics. Use the project key (phc_). A phs_ secret is ignored and is not sent to the browser.
# The snippet records page views, scans, and connect clicks. Session replay stays off.
PULSE_POSTHOG_KEY=
PULSE_POSTHOG_HOST=https://us.i.posthog.com

# Stripe. Prefer a restricted key. rk_live_ pushes to the live account.
# Leave billing off until a price should actually be sold.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING=
STRIPE_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION=
